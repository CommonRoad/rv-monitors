FROM gitlab.lrz.de:5005/maierhofer/rv-monitors/ci:0.5.0

ENV DEBIAN_FRONTEND noninteractive

# Required by Hydra, but already provided by main Docker image: make libboost-dev
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gnuplot clang m4 libgmp3-dev python3-pip \
        ocamlbuild ocaml-nox opam \
        && \
    rm -rf /var/lib/apt/lists/*

RUN pip3 install setuptools wheel && \
    pip3 install antlr4-python3-runtime pyyaml
RUN opam init --disable-sandboxing --comp=4.05.0 && \
    opam switch 4.05.0
Run opam install --yes ocamlfind safa menhir zarith

ENV HYDRA_DIR="/opt/hydra"
WORKDIR /opt/hydra

RUN git clone https://bitbucket.org/krle/hydra.git "${HYDRA_DIR}"

RUN cd third_party/aerial && eval $(opam config env) && make

RUN cd third_party/hydra-atva19 && make hydra

RUN cd third_party/monpoly && eval $(opam config env) && make

RUN cd third_party/pcre2-10.34 &&  \
    ./configure && \
    make

RUN cd third_party/reelay-codegen && \
    python3 setup.py build && \
    cp scripts/reelay reelay.py

RUN cd src && make hydra

RUN cd vydra && eval $(opam config env) && make

RUN cd evaluation && make evaluation

COPY ./evaluate.sh /commonroad
